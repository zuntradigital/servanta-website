# Absolute site URL, used for canonical links, hreflang and the sitemap.
NEXT_PUBLIC_SITE_URL=https://servanta.systems

# Endpoint that receives Contact / Request Demo / Newsletter submissions (POST, JSON).
# Also receives Contact Sales. When empty, production builds tell the visitor the form isn't connected
# and send nothing; `next dev` simulates success so the UI can be reviewed without a backend.
NEXT_PUBLIC_FORMS_ENDPOINT=

# Set to "false" to see the "not connected" state in `next dev` too.
NEXT_PUBLIC_FORMS_SIMULATE=

# Pricing API base URL (SRS-PRICING-PLANS-3-TIER §20). The site calls
# {base}/api/v1/public/plans and {base}/api/v1/public/plans/{code}.
# When empty, the seed in src/content/pricing.ts (mirrors the SRS) is served instead.
PRICING_API_BASE_URL=
